{
  "description": "Codex lifecycle metadata for MX Master 4 haptic notifications. Generate hooks.json with hooks/configure_hooks.py.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/absolute/path/to/repository/.local/bin/record-event'",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/absolute/path/to/repository/.local/bin/record-event'",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/absolute/path/to/repository/.local/bin/record-event'",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/absolute/path/to/repository/.local/bin/record-event'",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/absolute/path/to/repository/.local/bin/record-event'",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/absolute/path/to/repository/.local/bin/record-event'",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
