<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(DOTNET_CLI_HOME)/plugin-tests/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(DOTNET_CLI_HOME)/plugin-tests/bin/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../CodexHapticsPlugin/src/CodexHapticsPlugin.cs" Link="CodexHapticsPlugin.cs" />
    <Compile Include="../../CodexHapticsPlugin/src/Haptics*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../CodexHapticsPlugin/src/StopEvent*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../CodexHapticsPlugin/src/Actions/TestHapticCommand.cs" Link="TestHapticCommand.cs" />
    <Compile Include="../../CodexHapticsPlugin/src/Actions/ReloadHapticsConfigurationCommand.cs" Link="ReloadHapticsConfigurationCommand.cs" />
    <Compile Include="../../CodexHapticsPlugin/src/Helpers/PluginLog.cs" Link="PluginLog.cs" />
    <Content Include="../../CodexHapticsPlugin/src/package/events/**/*.yaml" Link="events/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
